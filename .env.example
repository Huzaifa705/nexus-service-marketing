# Copy this file to .env.local and fill in the values. NEVER commit real values.
# Only variable NAMES live in this file. Real values are entered in .env.local on your
# computer and in the hosting dashboards (Vercel, Supabase), never in Git, chat or code.
# The Supabase names below are confirmed in Node 3, when the Supabase projects exist.

# Which environment this is: local | staging | production
APP_ENV=local

# Supabase project (Node 3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Never expose to the browser and never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Time zone used to display dates (IANA name, for example Europe/London). Stored times are UTC.
DISPLAY_TIME_ZONE=
